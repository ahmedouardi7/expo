# SQL Scanning & Security Tools
SQL_SCAN_TOKEN=your_sql_scanning_token_here
SQL_DATABASE_URL=your_sql_database_connection_string

# API Keys & Authentication
API_TOKEN=your_api_token_here
DATABASE_TOKEN=your_database_token_here

# Expo Configuration
EXPO_TOKEN=your_expo_token_here

# Environment
NODE_ENV=development
DEBUG=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Google Services (if using Firebase/GCP)
GOOGLE_SERVICES_JSON=path_to_google_services.json
GOOGLE_SERVICE_INFO_PLIST=path_to_GoogleService-Info.plist

# Fastlane & Deployment
FASTLANE_USER=your_fastlane_user
FASTLANE_PASSWORD=your_fastlane_password

# Other Services
SLACK_TOKEN=your_slack_token
GITHUB_TOKEN=your_github_token